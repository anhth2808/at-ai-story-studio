{
  "name": "@studio/api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "db:migrate": "tsx ../../packages/database/src/migrate.ts"
  },
  "dependencies": {
    "@studio/database": "workspace:*",
    "@studio/media": "workspace:*",
    "@studio/shared": "workspace:*",
    "@studio/workflow": "workspace:*",
    "fastify": "^5.5.0",
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^9.2.1"
  },
  "devDependencies": {
    "tsx": "^4.20.5"
  }
}
