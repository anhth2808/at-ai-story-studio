{
  "name": "ai-story-studio",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @studio/api --filter @studio/web --filter @studio/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"apps/*/src/**/*.{ts,tsx,css}\" \"packages/*/src/**/*.ts\" \"apps/*/package.json\" \"packages/*/package.json\" \"*.json\" \"*.mjs\" \"*.ts\" \"docs/implementation/*.md\" \"openspec/changes/implement-long-story-engine/tasks.md\"",
    "format:check": "prettier --check \"apps/*/src/**/*.{ts,tsx,css}\" \"packages/*/src/**/*.ts\" \"apps/*/package.json\" \"packages/*/package.json\" \"*.json\" \"*.mjs\" \"*.ts\" \"docs/implementation/*.md\" \"openspec/changes/implement-long-story-engine/tasks.md\"",
    "db:migrate": "pnpm --filter @studio/database db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
